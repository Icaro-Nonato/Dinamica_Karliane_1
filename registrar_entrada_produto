produtos = [
    {"nome": "Teclado", "quantidade": 10},
    {"nome": "Mouse", "quantidade": 5}
]

def registrar_entrada():
    nome = input("Nome do produto: ")

    for produto in produtos:
        if produto["nome"].lower() == nome.lower():
            quantidade = int(input("Quantidade que entrou: "))

            if quantidade > 0:
                produto["quantidade"] += quantidade
                print("Entrada registrada com sucesso!")
                print(f"Estoque atual: {produto['quantidade']}")
            else:
                print("A quantidade deve ser maior que zero.")
            return

    print("Produto não encontrado no estoque.")

def listar_produtos():
    for produto in produtos:
        print(f"{produto['nome']} - Estoque: {produto['quantidade']}")

while True:
    print("\n1 - Registrar entrada")
    print("2 - Listar produtos")
    print("3 - Sair")

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        registrar_entrada()
    elif opcao == "2":
        listar_produtos()
    elif opcao == "3":
        break
    else:
        print("Opção inválida!")
